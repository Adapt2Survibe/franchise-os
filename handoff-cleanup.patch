-}
-
-// ─── FORMAT HELPERS ─────────────────────────────────────────────────────────
-
-function fmtTokens(n) {
-  if (typeof n !== 'number') return n;
-  if (n >= 1000000) return (n / 1000000).toFixed(1) + 'M';
-  if (n >= 1000) return (n / 1000).toFixed(0) + 'k';
-  return String(n);
-}
-
-function fmtUptime(startTime) {
-  if (!startTime) return '—';
-  const ms = Date.now() - startTime;
-  const mins = Math.floor(ms / 60000);
-  const hrs = Math.floor(mins / 60);
-  if (hrs > 0) return `${hrs}h${String(mins % 60).padStart(2,'0')}m`;
-  return `${mins}m`;
-}
-
-function timeNow() {
-  const now = new Date();
-  return `${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}:${String(now.getSeconds()).padStart(2,'0')}`;
-}
-
-// ─── RENDER ─────────────────────────────────────────────────────────────────
-
-function renderAll() {
-  renderRoster();
-  renderMissions();
-  renderTokens();
-  renderTerminal();
-  updateStats();
-}
-
-function renderRoster() {
-  const roster = document.getElementById('roster');
-  const empty = document.getElementById('roster-empty');
-
-  if (UNITS.length === 0) {
-    if (empty) empty.style.display = 'flex';
-    roster.querySelectorAll('.unit-card').forEach(c => c.remove());
-    return;
-  }
-  if (empty) empty.style.display = 'none';
-
-  // Rebuild
-  const existingCards = roster.querySelectorAll('.unit-card');
-  existingCards.forEach(c => c.remove());
-
-  UNITS.forEach(unit => {
-    const card = document.createElement('div');
-    card.className = `unit-card ${unit.status} ${unit.id === selectedUnit?.id ? 'selected' : ''}`;
-    card.innerHTML = `
-      <div class="unit-header">
-        ${drawSprite(unit, 32)}
-        <div class="unit-info">
-          <div class="unit-name">${unit.name}</div>
-          <div class="unit-role">${unit.role}</div>
-        </div>
-        <div class="unit-status status-${unit.status}">${unit.status}</div>
-      </div>
-      <div class="unit-task">${unit.task || '—'}</div>
-      <div class="unit-progress">
-        <div class="progress-bar ${unit.status}" style="width:${unit.progress}%"></div>
-      </div>
-    `;
-    card.addEventListener('click', () => selectUnit(unit));
-    roster.appendChild(card);
-  });
-}
-
-function renderMissions() {
-  const list = document.getElementById('mission-list');
-  list.innerHTML = '';
-  if (MISSIONS.length === 0) {
-    list.innerHTML = '<div class="empty-state"><div class="icon">⚑</div><div>NO ACTIVE MISSIONS</div></div>';
-    return;
-  }
-  MISSIONS.forEach(m => {
-    const item = document.createElement('div');
-    item.className = `mission-item ${m.status}`;
-    item.innerHTML = `
-      <div class="mission-priority priority-${m.priority}">${m.priority}</div>
-      <div class="mission-name">${m.name}</div>
-      <div class="mission-detail">${m.detail}</div>
-      <div class="mission-unit">▶ ${m.unit}</div>
-    `;
-    list.appendChild(item);
-  });
-}
-
-function renderTokens() {
-  const container = document.getElementById('agent-tokens');
-  container.innerHTML = '';
-  UNITS.forEach(unit => {
-    const token = document.createElement('div');
-    const isActive = unit.status === 'active' || unit.status === 'busy';
-    token.className = `agent-token ${isActive ? 'active-anim' : ''}`;
-    token.style.left = `${unit.mapX}%`;
-    token.style.top = `${unit.mapY}%`;
-    token.id = `token-${unit.id}`;
-    token.innerHTML = `
-      <div class="token-shadow"></div>
-      <div class="token-sprite">${drawSprite(unit, 40)}</div>
-      <div class="token-label">${unit.name}</div>
-      <div class="token-pulse ${unit.status}"></div>
-    `;
-    token.addEventListener('click', () => selectUnit(unit));
-    container.appendChild(token);
-  });
-}
-
-function renderTerminal() {
-  const term = document.getElementById('terminal');
-  const lines = LOG.slice(0, 8);
-  term.innerHTML = lines.map(l => `
-    <div class="terminal-line">
-      <span class="tl-time">[${l.time}]</span>
-      <span class="tl-unit">${l.unit}</span>
-      <span class="tl-msg ${l.type || ''}">${l.msg}</span>
-    </div>
-  `).join('') + `<div class="terminal-line"><span class="tl-time">></span><span class="terminal-cursor"></span></div>`;
-}
-
-function updateStats() {
-  const active = UNITS.filter(u => u.status === 'active').length;
-  const busy = UNITS.filter(u => u.status === 'busy').length;
-  const waiting = UNITS.filter(u => u.status === 'waiting').length;
-  document.getElementById('stat-active').textContent = active;
-  document.getElementById('stat-busy').textContent = busy;
-  document.getElementById('stat-waiting').textContent = waiting;
-  document.getElementById('stat-hooks').textContent = stats.totalHookEvents || UNITS.reduce((a, u) => a + (u.tasks || 0), 0);
-  document.getElementById('stat-tools').textContent = stats.totalToolCalls || UNITS.reduce((a, u) => a + (u.done || 0), 0);
-
-  // Mode badge
-  const modeBadge = document.getElementById('mode-badge');
-  if (UNITS.length > 0) {
-    modeBadge.textContent = `⚡ ${UNITS.length} OPERATIVE${UNITS.length > 1 ? 'S' : ''} DEPLOYED`;
-    modeBadge.classList.add('live');
-  } else {
-    modeBadge.textContent = '⏸ STANDBY';
-    modeBadge.classList.remove('live');
-  }
-}
-
-function selectUnit(unit) {
-  selectedUnit = unit;
-  renderRoster();
-
-  document.getElementById('detail-name').textContent = unit.name;
-  document.getElementById('detail-role').textContent = unit.role + ' — ' + (unit.agentType || 'Claude Code');
-  document.getElementById('detail-task').textContent = unit.task || '';
-  document.getElementById('detail-sprite').innerHTML = drawSprite(unit, 48).replace(/<svg[^>]*>/, '').replace('</svg>', '');
-  document.getElementById('d-tasks').textContent = unit.tasks || 0;
-  document.getElementById('d-done').textContent = unit.done || 0;
-  document.getElementById('d-tokens').textContent = fmtTokens(unit.tokens || 0);
-  document.getElementById('d-uptime').textContent = fmtUptime(unit.startTime);
-
-  const ring = document.getElementById('selection-ring');
-  ring.style.left = unit.mapX + '%';
-  ring.style.top = unit.mapY + '%';
-  ring.classList.add('visible');
-}
-
-// ─── WEBSOCKET ──────────────────────────────────────────────────────────────
-
-function connectWS() {
-  const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
-  ws = new WebSocket(`${proto}//${location.host}/ws`);
-
-  ws.onopen = () => {
-    wsConnected = true;
-    updateConnStatus('connected', 'LIVE — SERVER CONNECTED');
-    if (reconnectTimer) { clearTimeout(reconnectTimer); reconnectTimer = null; }
-  };
-
-  ws.onmessage = (e) => {
-    try {
-      const msg = JSON.parse(e.data);
-      if (msg.type === 'init' || msg.type === 'update') {
-        applyServerState(msg.state);
-      }
-    } catch (err) { /* ignore */ }
-  };
-
-  ws.onclose = () => {
-    wsConnected = false;
-    updateConnStatus('disconnected', 'DISCONNECTED — RECONNECTING...');
-    reconnectTimer = setTimeout(connectWS, 3000);
-  };
-
-  ws.onerror = () => {
-    ws.close();
-  };
-}
-
-function applyServerState(serverState) {
-  if (!serverState) return;
-  if (demoMode) return; // Don't overwrite demo mode
-
-  UNITS = serverState.sessions || [];
-  MISSIONS = serverState.missions || MISSIONS;
-  if (serverState.log && serverState.log.length > 0) {
-    LOG = serverState.log;
-  }
-  if (serverState.stats) {
-    stats = serverState.stats;
-  }
-
-  // Re-select if unit still exists
-  if (selectedUnit) {
-    const fresh = UNITS.find(u => u.id === selectedUnit.id);
-    if (fresh) selectedUnit = fresh;
-    else { selectedUnit = null; document.getElementById('selection-ring').classList.remove('visible'); }
-  }
-
-  renderAll();
-}
-
-function wsSend(data) {
-  if (ws && ws.readyState === 1) {
-    ws.send(JSON.stringify(data));
-  }
-}
-
-function updateConnStatus(status, label) {
-  const dot = document.getElementById('conn-dot');
-  const lbl = document.getElementById('conn-label');
-  dot.className = `conn-dot ${status}`;
-  lbl.textContent = label;
-}
-
-// ─── DEMO MODE ──────────────────────────────────────────────────────────────
-
-function toggleDemo() {
-  demoMode = !demoMode;
-  const btn = document.getElementById('demo-btn');
-
-  if (demoMode) {
-    btn.classList.add('active');
-    btn.textContent = 'LIVE';
-    UNITS = JSON.parse(JSON.stringify(DEMO_UNITS));
-    MISSIONS = JSON.parse(JSON.stringify(DEMO_MISSIONS));
-    LOG = JSON.parse(JSON.stringify(DEMO_LOG));
-    updateConnStatus('demo', 'DEMO MODE — SIMULATED DATA');
-    renderAll();
-    selectUnit(UNITS[0]);
-    startDemoSim();
-  } else {
-    btn.classList.remove('active');
-    btn.textContent = 'DEMO';
-    UNITS = [];
-    MISSIONS = [];
-    LOG = [];
-    selectedUnit = null;
-    document.getElementById('selection-ring').classList.remove('visible');
-    stopDemoSim();
-    if (wsConnected) {
-      updateConnStatus('connected', 'LIVE — SERVER CONNECTED');
-      // Request fresh state
-      wsSend({ command: 'refresh' });
-    } else {
-      updateConnStatus('disconnected', 'DISCONNECTED');
-    }
-    renderAll();
-  }
-}
-
-let demoInterval = null;
-
-function startDemoSim() {
-  demoInterval = setInterval(() => {
-    UNITS.forEach(u => {
-      if (u.status === 'active' && u.progress < 100) {
-        u.progress = Math.min(100, u.progress + (Math.random() * 0.8));
-        if (u.progress >= 100) {
-          u.status = 'idle';
-          u.task = 'Task complete — awaiting next order';
-          u.done++;
-          addLocalLog(u.name, `Task complete (${u.done}/${u.tasks})`, 'success');
-        }
-      }
-      if (u.status === 'busy' && u.progress < 100) {
-        u.progress = Math.min(100, u.progress + (Math.random() * 0.5));
-      }
-    });
-    renderRoster();
-    if (selectedUnit) {
-      const fresh = UNITS.find(u => u.id === selectedUnit.id);
-      if (fresh) {
-        document.getElementById('d-done').textContent = fresh.done || 0;
-        document.getElementById('d-uptime').textContent = fmtUptime(fresh.startTime);
-        document.getElementById('detail-task').textContent = fresh.task || '';
-      }
-    }
-  }, 2000);
-}
-
-function stopDemoSim() {
-  if (demoInterval) { clearInterval(demoInterval); demoInterval = null; }
-}
-
-// ─── LOCAL LOG ──────────────────────────────────────────────────────────────
-
-function addLocalLog(unit, msg, type = '') {
-  LOG.unshift({ time: timeNow(), unit: unit || 'COMMAND', msg, type });
-  if (LOG.length > 100) LOG.length = 100;
-  renderTerminal();
-}
-
-// ─── COMMAND BUTTONS ────────────────────────────────────────────────────────
-
-function spawnAgent() {
-  const name = prompt('Agent codename:') || 'OPERATIVE';
-  if (wsConnected && !demoMode) {
-    wsSend({ command: 'spawn', name });
-  } else {
-    const spriteIds = ['green-beret', 'sniper', 'sapper', 'spy', 'driver', 'marine'];
-    const idx = UNITS.length % spriteIds.length;
-    const colors = [
-      { color: '#3a5a2a', helmet: '#c8a96e', skin: '#c8a96e' },
-      { color: '#2a3a1a', helmet: '#8a8a6a', skin: '#d4aa70' },
-      { color: '#5a4a2a', helmet: '#aaaaaa', skin: '#c8a96e' },
-      { color: '#1a1a1a', helmet: '#1a1a1a', skin: '#c8a96e' },
-      { color: '#4a3a1a', helmet: '#c0c0c0', skin: '#d4aa70' },
-      { color: '#1a3a4a', helmet: '#8ab4c0', skin: '#c8a96e' },
-    ];
-    const newUnit = {
-      id: 'local-' + Date.now(),
-      name: name.toUpperCase(),
-      role: 'Field Agent',
-      spriteId: spriteIds[idx],
-      agentType: 'Claude Code',
-      status: 'active',
-      task: 'Awaiting orders...',
-      progress: 0,
-      mapX: 15 + Math.random() * 70,
-      mapY: 15 + Math.random() * 70,
-      tasks: 0, done: 0, tokens: 0,
-      startTime: Date.now(),
-      ...colors[idx],
-    };
-    UNITS.push(newUnit);
-    addLocalLog(newUnit.name, `Deployed to field — ${newUnit.role}`, 'success');
-    renderAll();
-  }
-}
-
-function sendOrder() {
-  if (!selectedUnit) { addLocalLog('COMMAND', 'ERROR: No unit selected', 'error'); return; }
-  const order = prompt(`Order for ${selectedUnit.name}:`);
-  if (order) {
-    selectedUnit.task = order;
-    selectedUnit.status = 'active';
-    selectedUnit.progress = 5;
-    addLocalLog(selectedUnit.name, `ORDER: ${order.slice(0, 50)}`, '');
-    renderAll();
-  }
-}
-
-function toggleFog() {
-  fogVisible = !fogVisible;
-  document.querySelectorAll('.fog-patch').forEach(f => { f.style.opacity = fogVisible ? '1' : '0'; });
-  addLocalLog('COMMAND', fogVisible ? 'FOG OF WAR: Enabled' : 'FOG OF WAR: Disabled', '');
-}
-
-function groupAll() { addLocalLog('COMMAND', 'All operatives assembled', 'success'); }
-
-function pauseAgent() {
-  if (!selectedUnit) { addLocalLog('COMMAND', 'ERROR: No unit selected', 'error'); return; }
-  if (wsConnected && !demoMode) {
-    wsSend({ command: 'pause', session: selectedUnit.id });
-  } else {
-    selectedUnit.status = 'idle';
-  }
-  addLocalLog(selectedUnit.name, 'Standing by', '');
-  renderAll();
-}
-
-function resumeAgent() {
-  if (!selectedUnit) { addLocalLog('COMMAND', 'ERROR: No unit selected', 'error'); return; }
-  if (wsConnected && !demoMode) {
-    wsSend({ command: 'resume', session: selectedUnit.id });
-  } else {
-    selectedUnit.status = 'active';
-  }
-  addLocalLog(selectedUnit.name, 'Re-engaged', 'success');
-  renderAll();
-}
-
-function viewLog() { addLocalLog('COMMAND', 'Viewing full mission log...', ''); }
-
-function addMission() {
-  const name = prompt('Mission name:');
-  if (name) {
-    MISSIONS.unshift({ name: name.toUpperCase(), detail: 'New mission — awaiting intel.', unit: selectedUnit?.name || '—', priority: 'normal', status: 'active' });
-    addLocalLog('COMMAND', `MISSION added: ${name}`, 'success');
-    renderAll();
-  }
-}
-
-function worktree() { addLocalLog('COMMAND', 'Opening worktree picker...', ''); }
-function openTerminal() { addLocalLog('COMMAND', 'Launching integrated shell...', ''); }
-
-function abortAgent() {
-  if (!selectedUnit) { addLocalLog('COMMAND', 'ERROR: No unit selected', 'error'); return; }
-  if (confirm(`ABORT ${selectedUnit.name}? This will terminate the agent session.`)) {
-    const name = selectedUnit.name;
-    if (wsConnected && !demoMode) {
-      wsSend({ command: 'abort', session: selectedUnit.id });
-    }
-    const idx = UNITS.findIndex(u => u.id === selectedUnit.id);
-    if (idx > -1) UNITS.splice(idx, 1);
-    selectedUnit = null;
-    document.getElementById('selection-ring').classList.remove('visible');
-    addLocalLog(name, 'Session terminated', 'error');
-    renderAll();
-  }
-}
-
-function extractAll() {
-  if (confirm('EXTRACT ALL? This will terminate all agent sessions.')) {
-    UNITS.length = 0;
-    selectedUnit = null;
-    document.getElementById('selection-ring').classList.remove('visible');
-    addLocalLog('COMMAND', 'All operatives recalled. Mission complete.', 'success');
-    renderAll();
-  }
-}
-
-// ─── KEYBOARD ───────────────────────────────────────────────────────────────
-
-document.addEventListener('keydown', e => {
-  if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
-  switch(e.key.toLowerCase()) {
-    case 'q': spawnAgent(); break;
-    case 'w': sendOrder(); break;
-    case 'v': toggleFog(); break;
-    case 'g': groupAll(); break;
-    case 'p': pauseAgent(); break;
-    case 'r': resumeAgent(); break;
-    case 'l': viewLog(); break;
-    case 'm': addMission(); break;
-    case 'b': worktree(); break;
-    case 'f': openTerminal(); break;
-    case 'x': abortAgent(); break;
-    case 'e': if(e.shiftKey) extractAll(); break;
-    case 'd': toggleDemo(); break;
-  }
-});
-
-// ─── CLOCK ──────────────────────────────────────────────────────────────────
-
-function updateClock() {
-  document.getElementById('clock').textContent = timeNow();
-}
-
-// ─── INIT ───────────────────────────────────────────────────────────────────
-
-renderAll();
-updateClock();
-setInterval(updateClock, 1000);
-connectWS();
-</script>
