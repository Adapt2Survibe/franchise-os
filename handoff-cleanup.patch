-    'sapper': `<ellipse cx="20" cy="12" rx="7" ry="6" fill="${h}"/><circle cx="20" cy="18" r="5" fill="${s}"/><rect x="15" y="22" width="10" height="12" fill="${c}"/><rect x="13" y="24" width="4" height="8" fill="${c}"/><rect x="23" y="24" width="4" height="8" fill="${c}"/><rect x="15" y="33" width="4" height="7" fill="${c}"/><rect x="21" y="33" width="4" height="7" fill="${c}"/><rect x="17" y="26" width="6" height="4" fill="#aaaaaa" rx="1"/>`,
