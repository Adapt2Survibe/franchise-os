-    'marine': `<ellipse cx="20" cy="11" rx="8" ry="5" fill="${h}"/><rect x="13" y="13" width="14" height="3" fill="${h}"/><circle cx="20" cy="18" r="5" fill="${s}"/><rect x="15" y="22" width="10" height="12" fill="${c}"/><rect x="12" y="22" width="5" height="10" fill="${c}"/><rect x="23" y="22" width="5" height="10" fill="${c}"/><rect x="15" y="33" width="4" height="7" fill="${c}"/><rect x="21" y="33" width="4" height="7" fill="${c}"/><rect x="14" y="28" width="12" height="2" fill="rgba(138,180,192,0.4)"/>`,
-  };
-
-  const body = sprites[id] || sprites['green-beret'];
