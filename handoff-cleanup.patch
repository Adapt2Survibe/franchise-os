+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>OPERATIVE HQ — Agent Command</title>
+<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>☠</text></svg>">
+<style>
+@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Oswald:wght@400;600;700&family=Special+Elite&display=swap');
+
+:root {
+  --olive: #4a5c2a;
+  --olive-dark: #2d3a18;
+  --olive-light: #6b7c3e;
+  --sand: #c8a96e;
+  --sand-light: #e8d4a0;
+  --sand-dark: #8a6f3e;
+  --khaki: #8b7355;
+  --dirt: #5c4a2a;
+  --black: #0a0a08;
+  --red: #8b1a1a;
+  --red-bright: #c0392b;
+  --green-hud: #39ff14;
+  --amber: #ffb347;
+  --fog: rgba(20, 25, 10, 0.85);
+  --panel-bg: rgba(10, 12, 6, 0.92);
+  --border: #4a5c2a;
+}
+
+* { margin: 0; padding: 0; box-sizing: border-box; }
+
+body {
+  background: var(--black);
+  font-family: 'Share Tech Mono', monospace;
+  color: var(--sand-light);
+  overflow: hidden;
+  height: 100vh;
+  width: 100vw;
+  cursor: crosshair;
+}
+
+/* ─── SCANLINES ─── */
+body::before {
+  content: '';
+  position: fixed;
+  inset: 0;
+  background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.12) 2px, rgba(0,0,0,0.12) 4px);
+  pointer-events: none;
+  z-index: 9999;
+}
+
+/* ─── VIGNETTE ─── */
+body::after {
+  content: '';
+  position: fixed;
+  inset: 0;
