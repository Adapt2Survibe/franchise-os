# ============================================================================
# Franchise OS — Environment Variables
# ============================================================================
# Copy this file to .env (project root) or dashboard-app/.env.local
# and fill in real values. NEVER commit actual secrets to git.
#
# Where to find each value is noted in comments below.
# ============================================================================

# --------------------------------------------------------------------------
# Supabase
# --------------------------------------------------------------------------
# Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://your-project.supabase.co

# Same as SUPABASE_URL — exposed to the browser in Next.js (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Dashboard → Settings → API → anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Dashboard → Settings → API → service_role key (KEEP SECRET — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --------------------------------------------------------------------------
# Clerk (Authentication)
# --------------------------------------------------------------------------
# Clerk Dashboard → API Keys → Publishable key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk Dashboard → API Keys → Secret key
CLERK_SECRET_KEY=sk_test_...

# Clerk Dashboard → Webhooks → Create endpoint → Signing secret
# Webhook URL: https://<your-domain>/api/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk Dashboard → your app domain (optional, for custom domains)
NEXT_PUBLIC_CLERK_DOMAIN=

# --------------------------------------------------------------------------
# Anthropic (AI — Claude models for the agent swarm)
# --------------------------------------------------------------------------
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# --------------------------------------------------------------------------
# OpenAI (used for Supabase Studio AI and embeddings)
# --------------------------------------------------------------------------
# platform.openai.com → API Keys
OPENAI_API_KEY=sk-...

# --------------------------------------------------------------------------
# Twilio (SMS & WhatsApp messaging)
# --------------------------------------------------------------------------
# Twilio Console → Account Info → Account SID
TWILIO_ACCOUNT_SID=AC...

# Twilio Console → Account Info → Auth Token
TWILIO_AUTH_TOKEN=your-auth-token-here

# Twilio Console → Phone Numbers → Active Numbers (E.164 format)
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# --------------------------------------------------------------------------
# Slack (Bot integration for the dashboard)
# --------------------------------------------------------------------------
# Slack App → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...

# Slack App → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret-here

# --------------------------------------------------------------------------
# App / Domain Configuration
# --------------------------------------------------------------------------
# Your app's public URL (Vercel auto-sets VERCEL_URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Primary brand domain
NEXT_PUBLIC_PRIMARY_DOMAIN=zorspace.io

# Skill Samurai brand domain
NEXT_PUBLIC_SKILL_SAMURAI_DOMAIN=os.skillsamurai.com

# --------------------------------------------------------------------------
# AI Model Overrides (optional — sensible defaults are built in)
# --------------------------------------------------------------------------
# Override which Claude model is used at each agent tier.
# Leave blank to use defaults.
# MODEL_STRATEGIC=claude-sonnet-4-6          # default: claude-sonnet-4-6
# MODEL_OPERATIONAL=claude-sonnet-4-6        # default: claude-sonnet-4-6
# MODEL_WORKER=claude-haiku-4-5-20251001     # default: claude-haiku-4-5-20251001

# --------------------------------------------------------------------------
# Swarm Scenario Overrides (optional — defaults to Skill Samurai)
# --------------------------------------------------------------------------
# Override the default brand context for swarm scenario scripts.
# BRAND_ID=6b66fd67-aa7e-46ab-9262-60ccfd3339c8
# BRAND_SLUG=skill-samurai

# --------------------------------------------------------------------------
# Server
# --------------------------------------------------------------------------
# Port for the Commandos HQ dev server (default: 2469)
# PORT=2469
